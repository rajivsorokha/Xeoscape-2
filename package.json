{
  "name": "xeoscape",
  "productName": "Xeoscape",
  "version": "2.1.0",
  "description": "Flexible point-of-sale / shop ERP supporting 19 store types from one codebase",
  "license": "UNLICENSED",
  "licensee": "Xeoscape",
  "main": "server.js",
  "author": {
    "name": "Xeoscape",
    "email": "support@xeoscape.example"
  },
  "scripts": {
    "server": "node server.js",
    "backend:build": "pkg server.js --targets node22-win-x64 --output src-tauri/binaries/xeoscape-backend-x86_64-pc-windows-msvc.exe",
    "backend:build:linux": "pkg server.js --targets node22-linux-x64 --output src-tauri/binaries/xeoscape-backend-x86_64-unknown-linux-gnu",
    "tauri": "tauri",
    "tauri:dev": "npm run backend:build && tauri dev",
    "tauri:build": "npm run backend:build && tauri build",
    "build:css": "gulp css",
    "build:js": "gulp js",
    "build": "gulp build && node build.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "lint": "eslint ."
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "archiver": "^7.0.1",
    "body-parser": "^1.20.6",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "csv-stringify": "^6.8.1",
    "express": "^4.22.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@tauri-apps/cli": "^2.11.4",
    "@yao-pkg/pkg": "^6.21.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "pkg": {
    "assets": [
      "assets/**/*",
      "index.html",
      "renderer.js",
      "config/**/*.json"
    ]
  }
}

{
  "identifier": "default",
  "description": "Capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/xeoscape-backend", "sidecar": true }
      ]
    },
    "dialog:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir"
  ]
}

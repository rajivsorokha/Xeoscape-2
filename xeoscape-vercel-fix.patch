diff --git a/api/serverless.js b/api/serverless.js
new file mode 100644
index 0000000..03c6ee0
--- /dev/null
+++ b/api/serverless.js
@@ -0,0 +1,47 @@
+// api/serverless.js
+// Vercel serverless entry point. Wraps the same Express app used by
+// server.js (via createServer()) with serverless-http so every
+// /api/* route works the same in production as it does locally --
+// no route logic is duplicated here.
+//
+// vercel.json routes all /api/(.*) requests to this function.
+//
+// Caveat: this app was built to run as a persistent process (NeDB
+// writes to disk, node-cron schedulers). On Vercel the data directory
+// is redirected to /tmp (see app.config.js) which is writable but NOT
+// persistent -- it can be wiped whenever a new instance/cold start
+// happens. Schedulers are skipped entirely in this environment (see
+// server.js). This gets the API working end-to-end on Vercel; for
+// real persistent data, point XEOSCAPE_DATA_DIR at an external store
+// or host the backend somewhere with a persistent disk instead.
+
+const { createServer } = require('../server');
+
+// Reused across warm invocations of the same function instance so we
+// don't rebuild the Express app (and re-run ensureDefaultAdmin) on
+// every single request.
+let appPromise = null;
+
+function getApp() {
+  if (!appPromise) {
+    appPromise = createServer().then(({ app }) => app);
+  }
+  return appPromise;
+}
+
+module.exports = async (req, res) => {
+  try {
+    const app = await getApp();
+    // An Express app is itself a valid (req, res) handler -- this is
+    // the standard way to run Express on Vercel's Node runtime.
+    return app(req, res);
+  } catch (err) {
+    // If app creation itself fails, don't cache the rejected promise --
+    // let the next invocation try again fresh instead of failing forever.
+    appPromise = null;
+    console.error('Serverless handler failed to initialize:', err);
+    res.statusCode = 500;
+    res.setHeader('Content-Type', 'application/json');
+    res.end(JSON.stringify({ error: 'Internal server error' }));
+  }
+};

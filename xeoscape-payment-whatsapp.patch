diff --git a/core/escpos.js b/core/escpos.js
new file mode 100644
index 0000000..1e87cde
--- /dev/null
+++ b/core/escpos.js
@@ -0,0 +1,131 @@
+// core/escpos.js
+// Builds a plain-text receipt as ESC/POS bytes, for sending straight to
+// a thermal printer (see core/raw-printer.js) instead of going through
+// the Windows print dialog / driver.
+//
+// Why: label-style printers (e.g. BluPrints Unnati) driven through a
+// page-based Windows driver keep feeding until their sensor finds a
+// label gap -- which never comes on a continuous roll -- so every
+// receipt is followed by a long blank strip. ESC/POS has no pages: the
+// printer prints the lines it is given, feeds the amount asked for,
+// and stops.
+//
+// Text only (no logo image) and ASCII only: most printers' default code
+// page has no rupee sign, so the symbol is printed as "Rs.".
+
+const ESC = 0x1b;
+const GS = 0x1d;
+const DOTS_PER_MM = 8; // 203 dpi
+const FONT_A_DOTS = 12; // character cell width, dots
+
+/** ASCII-only text: rupee sign -> "Rs.", accents stripped, rest -> "?". */
+function toAscii(text) {
+  return String(text ?? '')
+    .replace(/\u20B9/g, 'Rs.')
+    .normalize('NFKD').replace(/[\u0300-\u036f]/g, '')
+    .replace(/[\r\n\t]+/g, ' ')
+    .replace(/[^\x20-\x7e]/g, '?');
+}
+
+/** Characters per line for a roll of this width (font A). */
+function columnsFor(paperWidthMm) {
+  const printableDots = Math.min(Math.round((paperWidthMm - 4) * DOTS_PER_MM), 832);
+  return Math.max(16, Math.floor(printableDots / FONT_A_DOTS));
+}
+
+function wrap(text, width) {
+  const words = toAscii(text).split(' ').filter(Boolean);
+  const lines = [];
+  let line = '';
+  for (let word of words) {
+    while (word.length > width) { // a single over-long word
+      if (line) { lines.push(line); line = ''; }
+      lines.push(word.slice(0, width));
+      word = word.slice(width);
+    }
+    if (!line) line = word;
+    else if (line.length + 1 + word.length <= width) line += ` ${word}`;
+    else { lines.push(line); line = word; }
+  }
+  if (line) lines.push(line);
+  return lines.length ? lines : [''];
+}
+
+function money(amount, symbol) {
+  const n = Number(amount || 0).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
+  return toAscii(`${symbol || ''} ${n}`).trim();
+}
+
+/**
+ * @param {object} r receipt model: { storeName, tagline, addressLines[],
+ *   phone, gstin, title, date, items[{name,quantity,lineTotal}], subtotal,
+ *   discount, taxAmount, taxPercentage, total, paymentMethod, dueAmount,
+ *   footer, currencySymbol }
+ * @param {object} o { paperWidthMm, tailMm, shiftMm }
+ * @returns {Buffer}
+ */
+function buildReceiptBytes(r, { paperWidthMm = 80, tailMm = 8, shiftMm = 0 } = {}) {
+  const cols = columnsFor(paperWidthMm);
+  const sym = r.currencySymbol;
+  const chunks = [];
+  const raw = (...bytes) => chunks.push(Buffer.from(bytes));
+  const text = (s) => chunks.push(Buffer.from(`${toAscii(s)}\n`, 'ascii'));
+  const align = (n) => raw(ESC, 0x61, n); // 0 left, 1 centre, 2 right
+  const bold = (on) => raw(ESC, 0x45, on ? 1 : 0);
+  const size = (n) => raw(GS, 0x21, n); // 0x00 normal, 0x11 double w+h
+  const rule = () => text('-'.repeat(cols));
+  const pair = (left, right) => {
+    const l = toAscii(left);
+    const rt = toAscii(right);
+    if (l.length + 1 + rt.length <= cols) return text(l + ' '.repeat(cols - l.length - rt.length) + rt);
+    wrap(l, cols).forEach((ln) => text(ln));
+    return text(' '.repeat(Math.max(cols - rt.length, 0)) + rt);
+  };
+
+  raw(ESC, 0x40); // initialise
+  const shiftDots = Math.max(0, Math.round((Number(shiftMm) || 0) * DOTS_PER_MM));
+  if (shiftDots) raw(GS, 0x4c, shiftDots & 0xff, (shiftDots >> 8) & 0xff); // left margin
+
+  align(1);
+  bold(true); size(0x11);
+  wrap(r.storeName || '', Math.floor(cols / 2)).forEach((ln) => text(ln));
+  size(0x00); bold(false);
+  if (r.tagline) wrap(r.tagline, cols).forEach((ln) => text(ln));
+  (r.addressLines || []).filter(Boolean).forEach((a) => wrap(a, cols).forEach((ln) => text(ln)));
+  if (r.phone) text(`Ph: ${r.phone}`);
+  if (r.gstin) text(`GSTIN: ${r.gstin}`);
+  align(0);
+
+  rule();
+  align(1); bold(true); text(r.title ? `${r.title}  ${r.date || ''}`.trim() : r.date || ''); bold(false); align(0);
+  rule();
+
+  for (const li of r.items || []) {
+    pair(`${li.name} x${li.quantity}`, money(li.lineTotal, sym));
+  }
+  rule();
+  pair('Subtotal', money(r.subtotal, sym));
+  if (Number(r.discount) > 0) pair('Discount', `-${money(r.discount, sym)}`);
+  if (Number(r.taxAmount) > 0) pair(`GST (${r.taxPercentage}%)`, money(r.taxAmount, sym));
+  bold(true); size(0x01); // double height only, keeps the line within width
+  pair('TOTAL', money(r.total, sym));
+  size(0x00); bold(false);
+  if (r.paymentMethod) text(`Paid via ${r.paymentMethod}`);
+  if (Number(r.dueAmount) > 0) { bold(true); pair('Balance due', money(r.dueAmount, sym)); bold(false); }
+  rule();
+  align(1);
+  wrap(r.footer || 'Thank you for your business!', cols).forEach((ln) => text(ln));
+  align(0);
+
+  // Blank feed after the last line (so a hand tear clears the footer),
+  // in <=255-dot steps: ESC J n = print and feed n dots.
+  let feedDots = Math.round(Math.max(0, Number(tailMm) || 0) * DOTS_PER_MM);
+  while (feedDots > 0) {
+    const step = Math.min(feedDots, 255);
+    raw(ESC, 0x4a, step);
+    feedDots -= step;
+  }
+  return Buffer.concat(chunks);
+}
+
+module.exports = { buildReceiptBytes, columnsFor, toAscii };

+const PX_PER_MM = 96 / 25.4;
+
+/**
+ * Receipt-roll printing: builds an explicit `@page` size from the
+ * measured height of the content. `@page { size: 80mm auto }` looks
+ * like it should do this, but Chromium/WebView2 doesn't support `auto`
+ * for one dimension -- it drops the whole rule and the printer driver
+ * falls back to its default paper length, which is what feeds a metre
+ * of blank paper after a 10 cm receipt. An explicit height avoids it.
+ * `tailMm` is a little blank feed after the last line so the cutter
+ * doesn't slice through the footer.
+ */
+export function buildReceiptPageCss({ widthMm, contentHeightPx, tailMm = 8 }) {
+  const heightMm = Math.max(20, Math.ceil(contentHeightPx / PX_PER_MM + tailMm));
+  return `@page { size: ${widthMm}mm ${heightMm}mm; margin: 0; }`;
+}

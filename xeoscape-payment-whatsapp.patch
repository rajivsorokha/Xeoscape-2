+// api/print.js
+// "Direct print": builds an ESC/POS receipt and sends it straight to
+// the chosen Windows printer (see core/escpos.js, core/raw-printer.js).
+// The Windows print dialog is not involved.
+
+const express = require('express');
+const { requirePermission } = require('./auth-middleware');
+const { buildReceiptBytes } = require('../core/escpos');
+
+const SAMPLE = {
+  title: 'Test receipt',
+  items: [
+    { name: 'Test T-Shirt', quantity: 1, lineTotal: 299 },
+    { name: 'Test Frock (long item name to check wrapping)', quantity: 2, lineTotal: 1198 }
+  ],
+  subtotal: 1497, discount: 0, taxAmount: 269.46, taxPercentage: 18, total: 1766.46, paymentMethod: 'cash'
+};
+
+function buildPrintRouter({ storeProfile, rawPrinter }) {
+  const router = express.Router();
+
+  const num = (v, fallback) => (Number.isFinite(Number(v)) && v !== '' && v != null ? Number(v) : fallback);
+
+  async function settingsWith(overrides = {}) {
+    const p = await storeProfile.get();
+    return {
+      printerName: overrides.printerName ?? p.receiptPrinterName,
+      paperWidthMm: Math.min(Math.max(num(overrides.paperWidthMm ?? p.receiptPaperWidthMm, 80), 30), 120),
+      tailMm: Math.min(Math.max(num(overrides.tailMm ?? p.receiptTailMm, 8), 0), 60),
+      shiftMm: num(overrides.shiftMm ?? p.receiptShiftMm, 0),
+      profile: p
+    };
+  }
+
+  function cleanReceipt(body) {
+    const r = body && typeof body === 'object' ? body : {};
+    const items = Array.isArray(r.items) ? r.items.slice(0, 500) : [];
+    return {
+      ...r,
+      items: items.map((i) => ({ name: String(i?.name ?? ''), quantity: num(i?.quantity, 1), lineTotal: num(i?.lineTotal, 0) }))
+    };
+  }
+
+  router.get('/printers', requirePermission('perm_settings'), async (req, res) => {
+    try {
+      res.json({ supported: process.platform === 'win32', printers: await rawPrinter.listPrinters() });
+    } catch (err) {
+      res.json({ supported: false, printers: [], error: err.message });
+    }
+  });
+
+  router.post('/receipt', requirePermission('perm_transactions'), async (req, res) => {
+    try {
+      const s = await settingsWith();
+      const bytes = buildReceiptBytes(cleanReceipt(req.body?.receipt), s);
+      await rawPrinter.sendRaw(s.printerName, bytes);
+      res.json({ printed: true });
+    } catch (err) {
+      res.status(502).json({ error: err.message });
+    }
+  });
+
+  router.post('/test', requirePermission('perm_settings'), async (req, res) => {
+    try {
+      const s = await settingsWith(req.body || {});
+      const p = s.profile;
+      const receipt = {
+        ...SAMPLE,
+        storeName: p.storeName, tagline: p.tagline, addressLines: [p.addressLine1, p.addressLine2],
+        phone: p.contactNumber, gstin: p.taxId, footer: p.receiptFooter, currencySymbol: p.currencySymbol,
+        date: new Date().toLocaleString('en-IN')
+      };
+      await rawPrinter.sendRaw(s.printerName, buildReceiptBytes(receipt, s));
+      res.json({ printed: true });
+    } catch (err) {
+      res.status(502).json({ error: err.message });
+    }
+  });
+
+  return router;
+}
+
+module.exports = buildPrintRouter;

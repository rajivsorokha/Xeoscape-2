@@ -0,0 +1,68 @@
+// assets/js/shared/bill-message.js
+// Builds the WhatsApp bill text so it mirrors the on-screen / printed
+// receipt: shop header (name, tagline, address, phone, GSTIN), date,
+// item lines, Subtotal / Discount / GST / Total, payment line, footer.
+// Used by both the POS panel's WhatsApp button (unpaid bill) and the
+// receipt's WhatsApp button (paid receipt), so they always match.
+//
+// Uses WhatsApp's own formatting: *bold*, _italic_.
+// (A logo can't be part of a text message -- WhatsApp only accepts
+// images as separate media attachments.)
+
+import { formatMoney, formatDate } from './formatters.js';
+
+const RULE = '\u2500'.repeat(18);
+
+/**
+ * @param {object} o
+ * @param {object} o.profile        store profile (settingsStore.getProfile())
+ * @param {string} o.symbol         currency symbol
+ * @param {Array<{name:string, quantity:number, lineTotal:number}>} o.items
+ * @param {string|Date} [o.date]
+ * @param {number} o.subtotal
+ * @param {number} [o.discount]
+ * @param {number} [o.taxAmount]
+ * @param {number} [o.taxPercentage]
+ * @param {number} o.total
+ * @param {string} [o.paymentMethod]  omit for an unpaid bill
+ * @param {number} [o.dueAmount]
+ * @param {string} [o.title]
+ */
+export function buildBillMessage({
+  profile = {}, symbol = '', items = [], date = new Date(), subtotal = 0, discount = 0,
+  taxAmount = 0, taxPercentage = 0, total = 0, paymentMethod = null, dueAmount = 0, title = 'Bill'
+}) {
+  const money = (n) => formatMoney(n, symbol);
+
+  const header = [
+    `*${profile.storeName || 'Xeoscape'}*`,
+    profile.tagline ? `_${profile.tagline}_` : null,
+    profile.addressLine1 || null,
+    profile.addressLine2 || null,
+    profile.contactNumber ? `Ph: ${profile.contactNumber}` : null,
+    profile.taxId ? `GSTIN: ${profile.taxId}` : null
+  ].filter(Boolean);
+
+  const lines = items.map((li, i) => {
+    const qty = Number(li.quantity) || 1;
+    const each = qty > 1 ? ` (${money(li.lineTotal / qty)} each)` : '';
+    return `${i + 1}. ${li.name} x${qty}${each}\n     ${money(li.lineTotal)}`;
+  });
+
+  return [
+    ...header,
+    RULE,
+    `*${title}*  \u2022  ${formatDate(date)}`,
+    RULE,
+    ...lines,
+    RULE,
+    `Subtotal: ${money(subtotal)}`,
+    discount > 0 ? `Discount: -${money(discount)}` : null,
+    taxAmount > 0 ? `GST (${taxPercentage}%): ${money(taxAmount)}` : null,
+    `*Total: ${money(total)}*`,
+    paymentMethod ? `Paid via ${paymentMethod}` : null,
+    dueAmount > 0 ? `*Balance due: ${money(dueAmount)}*` : null,
+    RULE,
+    `_${profile.receiptFooter || 'Thank you for your business!'}_`
+  ].filter((l) => l !== null).join('\n');
+}

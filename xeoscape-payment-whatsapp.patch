@@ -0,0 +1,61 @@
+/** @jest-environment jsdom */
+import { printHtml, buildReceiptPageCss } from '../../assets/js/shared/print-utils.js';
+
+describe('buildReceiptPageCss', () => {
+  test('declares an explicit width AND height (never "auto")', () => {
+    // 377px = ~99.75mm of content, +8mm tail feed
+    const css = buildReceiptPageCss({ widthMm: 80, contentHeightPx: 377 });
+    expect(css).toBe('@page { size: 80mm 108mm; margin: 0; }');
+    expect(css).not.toMatch(/auto/);
+  });
+  test('never returns a degenerate page for empty content', () => {
+    expect(buildReceiptPageCss({ widthMm: 58, contentHeightPx: 0 })).toContain('58mm 20mm');
+  });
+});
+
+describe('printHtml receipt mode', () => {
+  const html = '<html><head><style>.receipt{width:100%}</style></head><body><div class="receipt">hi</div></body></html>';
+
+  beforeEach(() => {
+    document.head.innerHTML = '';
+    document.body.innerHTML = '<div id="app-root"></div>';
+    Object.defineProperty(HTMLElement.prototype, 'scrollHeight', { configurable: true, get() { return 377; } });
+    window.requestAnimationFrame = (cb) => cb();
+  });
+
+  test('sizes the page to the measured content and applies the sideways shift', async () => {
+    let printedCss = '';
+    window.print = jest.fn(() => {
+      printedCss = document.getElementById('app-print-style').textContent;
+      window.dispatchEvent(new Event('afterprint'));
+    });
+    await printHtml(html, { pageWidthMm: 80, offsetXmm: -3 });
+    expect(window.print).toHaveBeenCalledTimes(1);
+    expect(printedCss).toContain('@page { size: 80mm 108mm; margin: 0; }');
+    expect(printedCss).toContain('left: -3mm;');
+    // cleaned up afterwards
+    expect(document.getElementById('app-print-area')).toBeNull();
+    expect(document.getElementById('app-print-style')).toBeNull();
+  });
+
+  test('tailMm sets how much blank paper follows the receipt', async () => {
+    let printedCss = '';
+    window.print = jest.fn(() => {
+      printedCss = document.getElementById('app-print-style').textContent;
+      window.dispatchEvent(new Event('afterprint'));
+    });
+    // 377px = ~99.75mm content; +20mm tail = 119.75 -> 120mm
+    await printHtml(html, { pageWidthMm: 80, tailMm: 20 });
+    expect(printedCss).toContain('@page { size: 80mm 120mm; margin: 0; }');
+  });
+
+  test('without pageWidthMm (barcode labels) no @page is injected', async () => {
+    let printedCss = '';
+    window.print = jest.fn(() => {
+      printedCss = document.getElementById('app-print-style').textContent;
+      window.dispatchEvent(new Event('afterprint'));
+    });
+    await printHtml(html);
+    expect(printedCss).not.toContain('@page');
+  });
+});
diff --git a/tests/unit/raw-printer.test.js b/tests/unit/raw-printer.test.js
new file mode 100644
index 0000000..533165b
--- /dev/null
+++ b/tests/unit/raw-printer.test.js
@@ -0,0 +1,47 @@
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { createRawPrinter } = require('../../core/raw-printer');
+
+test('refuses to run off Windows', async () => {
+  const p = createRawPrinter({ platform: 'linux', execFile: jest.fn() });
+  await expect(p.sendRaw('X', Buffer.from('a'))).rejects.toThrow(/Windows/);
+  await expect(p.listPrinters()).rejects.toThrow(/Windows/);
+});
+
+test('sendRaw passes the printer name as an argument (no shell) and cleans up temp files', async () => {
+  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'rp-'));
+  const seen = {};
+  const execFile = jest.fn((cmd, args, opts, cb) => {
+    seen.cmd = cmd; seen.args = args;
+    seen.files = fs.readdirSync(tmp);
+    cb(null, '', '');
+  });
+  const p = createRawPrinter({ platform: 'win32', execFile, tmpDir: tmp });
+  await p.sendRaw('My "Printer"; calc', Buffer.from([1, 2, 3]));
+  expect(seen.cmd).toBe('powershell.exe');
+  expect(seen.args).toContain('My "Printer"; calc'); // one literal argv entry
+  expect(seen.args[seen.args.indexOf('-Printer') + 1]).toBe('My "Printer"; calc');
+  expect(seen.files.length).toBe(2); // script + data existed during the call
+  expect(fs.readdirSync(tmp)).toEqual([]); // and are removed afterwards
+});
+
+test('sendRaw surfaces PowerShell errors and still cleans up', async () => {
+  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'rp-'));
+  const execFile = (c, a, o, cb) => cb(new Error('x'), '', "Could not send data to printer 'P'.");
+  const p = createRawPrinter({ platform: 'win32', execFile, tmpDir: tmp });
+  await expect(p.sendRaw('P', Buffer.from('a'))).rejects.toThrow(/Could not send data/);
+  expect(fs.readdirSync(tmp)).toEqual([]);
+});
+
+test('listPrinters handles one printer (object) or many (array)', async () => {
+  const one = createRawPrinter({ platform: 'win32', execFile: (c, a, o, cb) => cb(null, '{"Name":"A","Default":true}', '') });
+  expect(await one.listPrinters()).toEqual([{ name: 'A', isDefault: true }]);
+  const many = createRawPrinter({ platform: 'win32', execFile: (c, a, o, cb) => cb(null, '[{"Name":"A","Default":false},{"Name":"B","Default":true}]', '') });
+  expect((await many.listPrinters()).map((x) => x.name)).toEqual(['A', 'B']);
+});
+
+test('sendRaw requires a printer name', async () => {
+  const p = createRawPrinter({ platform: 'win32', execFile: jest.fn() });
+  await expect(p.sendRaw('', Buffer.from('a'))).rejects.toThrow(/No printer selected/);
+});

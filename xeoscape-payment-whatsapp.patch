diff --git a/tests/unit/escpos.test.js b/tests/unit/escpos.test.js
new file mode 100644
index 0000000..e8fc4cd
--- /dev/null
+++ b/tests/unit/escpos.test.js
@@ -0,0 +1,44 @@
+const { buildReceiptBytes, columnsFor, toAscii } = require('../../core/escpos');
+
+const receipt = {
+  storeName: 'Mini Mode', tagline: 'Kids Wear by Seven Clans', addressLines: ['Uripok Khaiden Leikai', 'Imphal, Manipur - 795001'],
+  title: 'Receipt', date: 'Sep 23, 2026', currencySymbol: '\u20B9',
+  items: [{ name: 'blue T-Shirt', quantity: 1, lineTotal: 344 }],
+  subtotal: 344, discount: 0, taxAmount: 61.92, taxPercentage: 18, total: 405.92, paymentMethod: 'cash', footer: 'Thank you for shopping with us!'
+};
+
+test('columns follow the roll width', () => {
+  expect(columnsFor(50.8)).toBe(31);
+  expect(columnsFor(80)).toBe(50);
+  expect(columnsFor(101.6)).toBe(65);
+});
+
+test('rupee sign becomes Rs. and output is pure ASCII/ESC-POS', () => {
+  expect(toAscii('\u20B9 344')).toBe('Rs. 344');
+  const buf = buildReceiptBytes(receipt, { paperWidthMm: 50.8, tailMm: 0 });
+  expect(buf.subarray(0, 2)).toEqual(Buffer.from([0x1b, 0x40])); // ESC @ init
+  const text = buf.toString('latin1');
+  expect(text).toContain('Rs. 405.92');
+  expect(text).toContain('GST (18%)');
+  expect(text).toContain('Paid via cash');
+  expect(text).not.toContain('\u20B9');
+});
+
+test('no line is wider than the column count', () => {
+  const buf = buildReceiptBytes({ ...receipt, items: [{ name: 'A very long garment name that must wrap onto more lines', quantity: 3, lineTotal: 1234.5 }] }, { paperWidthMm: 50.8, tailMm: 0 });
+  const cols = columnsFor(50.8);
+  // strip ESC/GS control sequences, then check each printed line
+  const printable = buf.toString('latin1').replace(/\x1b[@aEJ][\x00-\xff]?|\x1b[@]|\x1d[!L][\x00-\xff]{1,2}/g, '');
+  printable.split('\n').forEach((ln) => { if (ln.length) expect(ln.length).toBeLessThanOrEqual(cols + 2); });
+});
+
+test('ends with a blank feed of tailMm (ESC J), no cut command', () => {
+  const buf = buildReceiptBytes(receipt, { paperWidthMm: 80, tailMm: 20 }); // 160 dots
+  expect(buf.subarray(buf.length - 3)).toEqual(Buffer.from([0x1b, 0x4a, 160]));
+  expect(buf.includes(Buffer.from([0x1d, 0x56]))).toBe(false); // GS V = cut
+});
+
+test('long feeds are split into <=255 dot steps', () => {
+  const buf = buildReceiptBytes(receipt, { paperWidthMm: 80, tailMm: 40 }); // 320 dots = 255 + 65
+  expect(buf.subarray(buf.length - 6)).toEqual(Buffer.from([0x1b, 0x4a, 255, 0x1b, 0x4a, 65]));
+});
diff --git a/tests/unit/payment-prefill.test.js b/tests/unit/payment-prefill.test.js
